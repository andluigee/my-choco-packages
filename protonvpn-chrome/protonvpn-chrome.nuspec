<?xml version="1.0" encoding="utf-8"?>
<!-- Do not remove this test for UTF-8: if “Ω” doesn’t appear as greek uppercase omega letter enclosed in quotation marks, you should use an editor that supports UTF-8, not this one. -->
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>protonvpn-chrome</id>
    <version>1.0.0</version>
    <owners>alg</owners>
    <title>ProtonVPN Chromium Extension</title>
    <authors>Proton AG</authors>
    <projectUrl>https://protonvpn.com/</projectUrl>
    <summary>Proton VPN browser extension</summary>
    
    <description>
    Secure your internet and protect your online privacy in one click.
    
    Proton VPN is the world's only free VPN app that is safe to use and respects your privacy with no usage limitations. 
    
    Proton VPN is created by the CERN scientists behind Proton Mail - the world's largest encrypted email service. 
    
    Our fast VPN offers secure, private, encrypted, and unlimited internet access with advanced privacy and security features. 
    
    Proton VPN also unblocks access to popular websites and streaming platforms.
        
    *NOTES:* 
    
    * Version number is not relevant, it ensures that when the packages is installed it always pulls the latest version
    * When installing this package your browser will alert you of changes/action needed, from there you can enable the extension through the browser settings 
    * This was tested without googlechrome dependencies using Google Chrome, Brave, and Vivaldi Web browsers, other Blink/Chromium-based browsers are not guaranteed to work
    * Microsoft Edge, Opera, and Opera-GX where tested and do not work with this package 
    </description>

    <licenseUrl>https://proton.me/legal/terms</licenseUrl>
    <packageSourceUrl>https://github.com/andluigee/my-choco-packages</packageSourceUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/andluigee/my-choco-packages@ad36acff2cc65325a5a57ae98e72d698523b3835/protonvpn-chrome/icons/protonvpn-icon.png</iconUrl>
    <copyright>Copyright 2026</copyright>
    <tags>ProtonVPN VPN Proton AG Extension Chromium Chrome Brave Vivaldi</tags>
    </metadata>
  <files>
    <!-- this section controls what actually gets packaged into the Chocolatey package -->
    <file src="tools\**" target="tools" />
  </files>
</package>